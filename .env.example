# Database
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fullstack_db
POSTGRES_PORT=5435

# Backend
BACKEND_PORT=3001
BACKEND_API_URL=http://backend:3001

# Frontend
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_REQUEST_TIMEOUT=20000

# Auth
BCRYPT_HASH_ROUND=12
JWT_SECRET=super-secret
JWT_REFRESH_SECRET=refresh-super-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super-secret
# Set false only for local http; must be true behind HTTPS in production.
COOKIE_SECURE=false

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=wedding-management-project
CLOUDFLARE_PUBLIC_URL=