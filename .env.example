# Database
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fullstack_db
POSTGRES_PORT=5435
# Managed Postgres alternative — when set, it replaces the five vars above.
# DATABASE_URL=
# Required for a managed Postgres reached over the public internet. Leave
# false for local compose and for Render's internal hostname.
POSTGRES_SSL=false

# Backend
BACKEND_PORT=3001
BACKEND_API_URL=http://backend:3001
# Enable wherever the app runs behind a platform proxy (Render, Fly, Vercel),
# so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=false

# Frontend
FRONTEND_PORT=3000
# Comma-separated; every browser origin that may call this API with cookies.
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_REQUEST_TIMEOUT=20000

# Auth
BCRYPT_HASH_ROUND=12
JWT_SECRET=super-secret
JWT_REFRESH_SECRET=refresh-super-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super-secret
# Set false only for local http; must be true behind HTTPS in production.
COOKIE_SECURE=false

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=wedding-management-project
CLOUDFLARE_PUBLIC_URL=