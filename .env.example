NODE_ENV=development
HOSTNAME=0.0.0.0

# Database
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fullstack_db
POSTGRES_PORT=5435
# Managed Postgres alternative — when set, it replaces the five vars above.
# DATABASE_URL=
# Connect over TLS. Deliberately independent of NODE_ENV, and required to be
# set explicitly there: the local container has no TLS listener, managed
# Postgres needs it on.
DATABASE_SSL=false
# Check the database's certificate. Leave this true — false is TLS that any
# man-in-the-middle can terminate. If the provider's chain is not publicly
# trusted, keep it true and paste their CA into DATABASE_SSL_CA instead.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=

# Backend
BACKEND_PORT=3011
BACKEND_API_URL=http://backend:3011
TRUST_PROXY=false

# Frontend
FRONTEND_PORT=3010
CORS_ORIGIN=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3011
NEXT_PUBLIC_API_REQUEST_TIMEOUT=20000
NEXT_PUBLIC_SHOW_LOGGER=false

# Auth
BCRYPT_HASH_ROUND=12
JWT_SECRET=super-secret
JWT_REFRESH_SECRET=refresh-super-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=super-secret
COOKIE_SECURE=false

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=wedding-management-project
CLOUDFLARE_PUBLIC_URL=
